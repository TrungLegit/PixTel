{
  "name": "pixtel",
  "version": "2.0.0",
  "description": "PIXTEL — Open-World 16-Bit Top-Down Pixel Action RPG powered by Vite, TypeScript & pixelfx",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sfx": "python3 scripts/convert_sfx.py",
    "server": "./node_modules/.bin/esbuild server/coopServer.ts --bundle --platform=node --format=esm --external:ws --outfile=node_modules/.cache/coopServer.mjs && PIXTEL_RUN_SERVER=1 node node_modules/.cache/coopServer.mjs",
    "test": "./node_modules/.bin/esbuild tests/featureTests.ts --bundle --platform=node --format=esm --external:ws --external:peerjs --loader:.png=dataurl --outfile=node_modules/.cache/featureTests.mjs && node node_modules/.cache/featureTests.mjs"
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "ws": "^8.23.0"
  },
  "license": "MIT"
}
